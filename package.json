{
  "name": "memsdk",
  "version": "0.0.0",
  "description": "Drop-in TypeScript interface compatibility for Supermemory-shaped AI memory backends.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wazootech/memsdk.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "COMPATIBILITY.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "drift:openapi": "bun scripts/check-openapi-drift.ts",
    "drift:sdk": "bun add -d --exact supermemory@latest && bun run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "npm run build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.nodom.json && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.10",
    "eslint": "^9.20.0",
    "prettier": "^3.9.5",
    "supermemory": "5.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.24.0"
  }
}
